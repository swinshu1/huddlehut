{
  "mcpServers": {
    "huddlehut": {
      "command": "uv",
      "args": ["run", "--quiet", "--directory", "${CLAUDE_PLUGIN_ROOT}", "huddlehut-mcp"],
      "env": {
        "HUDDLEHUT_AGENT": "${user_config.agent_name}",
        "HUDDLEHUT_DATABASE_URL": "${user_config.database_url}",
        "HUDDLEHUT_ANTHROPIC_API_KEY": "${user_config.anthropic_api_key}",
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv"
      }
    }
  }
}
